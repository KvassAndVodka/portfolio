# Database and authentication
DATABASE_URL=postgresql://postgres:password@postgres:5432/portfolio
POSTGRES_PASSWORD=change-me
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
AUTH_SECRET=replace-with-a-long-random-secret
ANALYTICS_HASH_SECRET=replace-with-a-separate-long-random-secret
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Canonical public origin used by metadata, social cards, robots.txt, and sitemap.xml.
SITE_URL=https://portfolio.jmraut.dev

# IndexNow verification key (8-128 alphanumeric or hyphen chars; served at /indexnow-key.txt). Empty disables IndexNow.
INDEXNOW_KEY=

# Local-only admin preview. Ignored in production even when set to true.
DEV_ADMIN_BYPASS=false

# Contact form email delivery (Resend)
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_TO_EMAIL=javier.raut@gmail.com
CONTACT_FROM_EMAIL=Portfolio <contact@your-verified-domain.com>

# Production Cloudflare Tunnel token. Keep this secret and never commit it.
CLOUDFLARE_TUNNEL_TOKEN=

# Weekly content job: bearer token for POST/GET /api/drafts. Empty turns the endpoint off.
DRAFTS_API_TOKEN=

# Owner door (/api/drafts/owner): publish, stage edits of live posts, trash. Keep it off the weekly job.
CONTENT_OWNER_TOKEN=

# Github Stats
GITHUB_STATS_TOKEN=